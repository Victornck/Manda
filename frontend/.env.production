# Login com Google. O Client ID é PÚBLICO (vai no bundle de qualquer jeito), então
# fica aqui para o build de produção no servidor tê-lo (o frontend/.env é gitignored
# e não chega na VPS).
VITE_GOOGLE_CLIENT_ID=262917604424-poqukdif0scbudqcdg5g0gefqp19v6vm.apps.googleusercontent.com

# Monitoramento de erro (Sentry) do front. O DSN é público (vai no bundle). Liga o
